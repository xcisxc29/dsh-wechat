# Use a hoisted node_modules layout.
#
# The default isolated layout gives each package its dependencies as *siblings*
# under `.pnpm/<pkg>@<version>/node_modules/` and relies on symlinking to make them
# resolvable. That breaks for a package whose dependency has no corresponding entry
# in a `node_modules` directory reachable by walking up from the requiring file —
# which is what happens to `qrcode` and its `dijkstrajs`/`pngjs` dependencies here.
# The failure surfaces as `Cannot find module 'dijkstrajs'` at runtime.
#
# Hoisting resolves dependencies the way Node actually looks for them, so what
# works in this workspace also works once the bundle is packed and installed.
node-linker=hoisted

# Let `pnpm run` and `pnpm test` proceed when pnpm decides the modules directory needs rebuilding.
#
# pnpm checks dependencies before running a script, and when it thinks they are stale it removes and
# reinstalls them — but it refuses to do that without an interactive terminal, so the command aborts
# with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY. That turns a plain `pnpm test` into an install
# prompt no automation can answer. The reinstall itself is safe here: nothing in this workspace is
# patched by hand, and the lockfile pins everything.
confirm-modules-purge=false
